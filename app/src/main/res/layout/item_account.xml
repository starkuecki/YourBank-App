<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_account"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_account_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHECKING"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_account_type_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="current"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edittext_rounded_bg"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_account_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 0.00"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_below="@id/tv_account_label"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_account_iban"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DE12 ..."
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:layout_below="@id/tv_account_balance"
            android:layout_marginTop="4dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
